def forget_drive(pool, cfg):
    """Remove everything the host keeps about a drive: its bookmarks and leftover
    snapshots on the source, its job records and logs, and its cached label.
    The drive itself is not touched."""
    if not POOL_RE.match(pool or ""):
        raise VSError("bad pool name")
    if any(d["pool"] == pool for d in usb_disks(cfg)):
        raise VSError("unplug the drive before deleting it")
    if pool in imported_pools():
        raise VSError(f"{pool} is still imported; eject or reconnect it first")
    if any(j.get("pool") == pool for j in active_jobs()):
        raise VSError("a job is running for this drive")
    prefix = f"{SNAP_PREFIX}{pool[len(POOL_PREFIX):]}-"
    removed = 0
    for s in snap_list(cfg["source"], prefix):
        run(["zfs", "destroy", "-r", s["name"]], check=False)
        removed += 1
    for ds in source_datasets(cfg):
        for b in snap_list(ds, prefix, "bookmark"):
            run(["zfs", "destroy", b["name"]], check=False)
            removed += 1
    jobs = 0
    for j in list_jobs():
        if j.get("pool") == pool or (j.get("result") or {}).get("pool") == pool:
            for path in (os.path.join(jobs_dir(), f"{j['id']}.json"), os.path.join(logs_dir(), f"{j['id']}.log")):
                try:
                    os.remove(path)
                except FileNotFoundError:
                    pass
            jobs += 1
    known = known_drives()
    if known.pop(pool, None) is not None:
        atomic_write_json(known_path(), known)
    _state_cache["t"] = 0
    return {"pool": pool, "zfs_objects_removed": removed, "jobs_removed": jobs}


def cmd_forget(args, cfg):
    if not args.yes:
        got = input(f"Delete everything the host keeps about {args.pool}? Type the pool name: ").strip()
        if got != args.pool:
            sys.exit("not confirmed")
    r = forget_drive(args.pool, cfg)
    print(f"removed {r['zfs_objects_removed']} bookmark(s)/snapshot(s) and {r['jobs_removed']} job record(s)")


def cmd_reconnect(args, cfg):
    pools = [args.drive] if args.drive else [
        n for n, p in imported_pools().items() if POOL_RE.match(n) and p["health"] not in ("ONLINE", "DEGRADED")]
    if args.drive and not POOL_RE.match(args.drive):
        pools = [find_drive(args.drive, cfg)["pool"]]
    if not pools:
        print("no disconnected backup drives")
        return 0
    rc = 0
    for pool in pools:
        try:
            reconnect_pool(pool)
            print(f"{pool} reconnected; run 'vaultsync sync' to resume, or 'vaultsync eject'")
        except VSError as e:
            print(f"error: {e}", file=sys.stderr)
            rc = 1
    return rc


def cmd_cleanup(args, cfg):
    removed = cleanup_stale(cfg)
    print(f"removed {len(removed)} snapshot(s)")


def cmd_internal_run(args, cfg):
    job = Job.load(args.job)
    return execute(job, cfg)


def main(argv=None):
    ap = argparse.ArgumentParser(prog="vaultsync", description="Rotating ZFS backups to USB drives")
    ap.add_argument("--version", action="version", version=VERSION)
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("status").set_defaults(fn=cmd_status)
    sub.add_parser("ports").set_defaults(fn=cmd_ports)
    sub.add_parser("drives").set_defaults(fn=cmd_drives)
    p = sub.add_parser("init", help="ERASE a USB disk and make it a backup drive")
    p.add_argument("device")
    p.add_argument("--label", required=True)
    p.add_argument("--yes", action="store_true", help="skip the typed confirmation")
    p.set_defaults(fn=cmd_init)
    for name, fn in (("sync", cmd_sync), ("plan", cmd_plan), ("verify", cmd_verify), ("eject", cmd_eject)):
        p = sub.add_parser(name)
        p.add_argument("drive", nargs="?", help="pool name, label or serial (default: the only attached drive)")
        p.set_defaults(fn=fn)
    p = sub.add_parser("jobs")
    p.add_argument("--limit", type=int, default=20)
    p.set_defaults(fn=cmd_jobs)
    p = sub.add_parser("log")
    p.add_argument("job")
    p.set_defaults(fn=cmd_log)
    p = sub.add_parser("cancel")
    p.add_argument("job")
    p.set_defaults(fn=cmd_cancel)
    sub.add_parser("cleanup").set_defaults(fn=cmd_cleanup)
    p = sub.add_parser("forget", help="delete the host's bookmarks and job history for a drive")
    p.add_argument("pool")
    p.add_argument("--yes", action="store_true")
    p.set_defaults(fn=cmd_forget)
    p = sub.add_parser("reconnect", help="reattach a drive that was unplugged while in use")
    p.add_argument("drive", nargs="?")
    p.set_defaults(fn=cmd_reconnect)
    p = sub.add_parser("agent")
    p.add_argument("--listen")
    p.add_argument("--port", type=int)
    p.set_defaults(fn=cmd_agent)
    p = sub.add_parser("_run")
    p.add_argument("job")
    p.set_defaults(fn=cmd_internal_run)
    args = ap.parse_args(argv)
    if os.geteuid() != 0 and not os.environ.get("VAULTSYNC_ALLOW_NONROOT"):
        sys.exit("vaultsync must run as root")
    cfg = load_config()
    try:
        return args.fn(args, cfg) or 0
    except VSError as e:
        print(f"error: {e}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
