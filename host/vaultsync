# ---------------------------------------------------------------- utilities


class VSError(Exception):
    pass


def now_iso():
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat()


def stamp():
    return dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")


def stamp_age_days(name):
    m = re.search(r"(\d{8}T\d{6}Z)$", name)
    if not m:
        return None
    t = dt.datetime.strptime(m.group(1), "%Y%m%dT%H%M%SZ").replace(tzinfo=dt.timezone.utc)
    return (dt.datetime.now(dt.timezone.utc) - t).total_seconds() / 86400


def human(n):
    n = float(n or 0)
    for unit in ("B", "KB", "MB", "GB", "TB", "PB"):
        if abs(n) < 1000 or unit == "PB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1000
    return f"{n:.1f} PB"


def hms(sec):
    if sec is None:
        return "--"
    sec = int(sec)
    h, rem = divmod(sec, 3600)
    m, s = divmod(rem, 60)
    return f"{h}h{m:02d}m" if h else f"{m}m{s:02d}s"


def _abandon(p):
    """Kill a child that timed out. A process stuck on a suspended ZFS pool can't
    die until the pool resumes, so never block waiting for it."""
    try:
        p.kill()
    except OSError:
        pass
    threading.Thread(target=p.wait, daemon=True).start()


def run(cmd, check=True, input=None, timeout=300):
    try:
        p = subprocess.Popen(cmd, stdin=subprocess.PIPE if input is not None else subprocess.DEVNULL,
                             stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    except FileNotFoundError:
        if check:
            raise VSError(f"{cmd[0]} is not installed") from None
        return ""
    try:
        out, err = p.communicate(input=input, timeout=timeout)
    except subprocess.TimeoutExpired:
        _abandon(p)
        raise VSError(f"{' '.join(shlex.quote(c) for c in cmd)} did not finish within {timeout}s "
                      f"(is a backup drive disconnected? see 'zpool status -x')") from None
    if check and p.returncode != 0:
        raise VSError(f"{' '.join(shlex.quote(c) for c in cmd)} failed: {(err or out).strip()}")
    return out


def run_q(cmd, timeout=15):
    """Query that must never hang the caller. Returns stdout, or "" on error/timeout."""
    try:
        return run(cmd, check=False, timeout=timeout)
    except VSError:
        return ""


def atomic_write_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.tmp{os.getpid()}"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
    os.replace(tmp, path)


def read_json(path, default=None):
    try:
        with open(path) as f:
            return json.load(f)
    except (FileNotFoundError, json.JSONDecodeError):
        return default


def _read(path, default=""):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def pid_alive(pid):
    if not pid:
        return False
    try:
        os.kill(int(pid), 0)
        return True
    except (ProcessLookupError, ValueError):
        return False
    except PermissionError:
        return True


# ---------------------------------------------------------------- config


def load_config():
    cfg = dict(DEFAULT_CONFIG)
    cfg.update(read_json(CONFIG_PATH, {}) or {})
    return cfg


def save_config(cfg):
    atomic_write_json(CONFIG_PATH, cfg)
    os.chmod(CONFIG_PATH, 0o600)


