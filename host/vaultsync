def cmd_init(args, cfg):
    disks = {d["device"]: d for d in usb_disks(cfg)}
    dev = args.device if args.device.startswith("/dev/") else f"/dev/{args.device}"
    d = disks.get(dev)
    if not d:
        sys.exit(f"{dev} is not an attached USB disk (see 'vaultsync drives')")
    print(f"\nThis will ERASE {dev}: {d['model']} serial {d['serial']} ({human(d['size'])})")
    if d["partitions"]:
        for p in d["partitions"]:
            print(f"   {p['name']}  {human(p['size'])}  {p.get('fstype') or ''} {p.get('label') or ''}")
    if not args.yes:
        got = input(f"Type the new label '{args.label}' to confirm: ").strip()
        if got != args.label:
            sys.exit("not confirmed")
    return run_foreground("init", {"device": dev, "serial": d["serial"], "label": args.label}, cfg)


def cmd_sync(args, cfg):
    d = find_drive(args.drive, cfg)
    if d["port_mode"] == "ignored":
        sys.exit("drive is on a port marked ignored; move it to an active port")
    if d["speed"] and d["speed"] < 5000:
        print(f"note: drive is connected at {d['speed']} Mb/s (USB 2); a full copy will be slow")
    return run_foreground("sync", {"pool": d["pool"], "label": d["label"]}, cfg)


def cmd_verify(args, cfg):
